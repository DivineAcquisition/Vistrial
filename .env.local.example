# Copy to .env.local and fill in from Supabase → Project Settings → API keys.
# .env.local is gitignored. Never commit real keys.
#
# The live Vistrial project (DivineAcquisition™ org) is ref vsbzcbiyvaihhejjsypn:
# https://supabase.com/dashboard/project/vsbzcbiyvaihhejjsypn

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
