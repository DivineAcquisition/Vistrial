# Copy to .env.local and fill in from Supabase → Project Settings → API keys.
# .env.local is gitignored. Never commit real keys.
#
# The live Vistrial project (DivineAcquisition™ org) is ref vsbzcbiyvaihhejjsypn:
# https://supabase.com/dashboard/project/vsbzcbiyvaihhejjsypn

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional legacy fallback only. Staff, client, and webhook base URLs live in
# app_settings (Settings → Hosts and mail) and must not be inferred from the
# request host. See docs/DNS-REFERENCE.md for registrar records (reference only).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notifications. RESEND_API_KEY stays in the environment. From-address and
# reply-to are configured in Settings (defaults send from mail.vistrial.io).
# NOTIFICATION_FROM remains a fallback until settings are saved.
RESEND_API_KEY=
NOTIFICATION_FROM=Vistrial <noreply@mail.vistrial.io>

# Where dispute alerts and the daily attention digest are delivered. Without
# it those notices are still recorded as failed delivery.
ADMIN_NOTIFY_EMAIL=ops@your-domain.com

# Stripe. Card details never reach this application: capture happens in
# Stripe's own hosted flow and only references come back.
#
# An sk_live_ key moves real money on every cycle the job runs. The billing
# screen says which mode it is in, and every payment attempt records it.
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint (whsec_...). Without it
# /api/webhooks/stripe refuses every request, and outcomes that arrive after
# the payment request returned — a late acceptance, a chargeback, a reissued
# card — are never seen.
STRIPE_WEBHOOK_SECRET=

# The largest single charge that will be attempted, in whole currency units.
# Anything above it is refused and raised to the attention view instead of
# being collected. Defaults to 10000.
STRIPE_MAX_CHARGE=

# The shared secret a scheduler presents to POST /api/jobs/cycle,
# /api/jobs/attention-digest, and /api/jobs/weekly-summary. Without it those
# endpoints stay closed. The jobs are safe to run as often as you like.
CRON_SECRET=
