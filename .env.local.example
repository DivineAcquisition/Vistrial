# ============================================
# SUPABASE
# Classic names and Vercel Marketplace aliases both work.
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# ============================================
# ANTHROPIC (transcript extraction, suggested opening)
# Extraction runs after a transcript lands, never on view.
# ANTHROPIC_MODEL defaults to claude-sonnet-4-6.
# Follow-up drafting uses a frontier-tier model (ANTHROPIC_DRAFT_MODEL, default claude-opus-4-6).
# Do not point drafting at Haiku.
# ============================================
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_DRAFT_MODEL=

# ============================================
# GOHIGHLEVEL (CRM + messaging layer)
# Marketplace OAuth + webhook signatures.
# Redirect URI must be ${NEXT_PUBLIC_APP_URL}/api/ghl/oauth/callback
# Production: https://app.vistrial.io/api/ghl/oauth/callback
# Default webhook URL must be ${NEXT_PUBLIC_APP_URL}/api/ghl/webhooks
# Production: https://app.vistrial.io/api/ghl/webhooks
# GHL_WEBHOOK_SECRET is unused. Signatures use HighLevel Ed25519/RSA public keys.
# ============================================
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# 32-byte key as 64 hex chars: openssl rand -hex 32
GHL_TOKEN_ENCRYPTION_KEY=
# Optional PEM overrides for webhook signatures. Defaults are HighLevel's published keys.
# GHL_WEBHOOK_ED25519_PUBLIC_KEY=
# GHL_WEBHOOK_RSA_PUBLIC_KEY=
# Optional. POST JSON { kind, orgId, backlog, oldestUnprocessedAgeSeconds, detail } when ingest stalls.
# INGESTION_ALERT_WEBHOOK_URL=

# ============================================
# APP
# Site URL in the Supabase dashboard must match this value.
# Local: http://localhost:3000
# Production: https://app.vistrial.io
# Redirect URLs must include both /auth/callback origins.
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# MARKETING SITE (vistrial.io)
# Public origin for canonical URLs and OG tags. Ignored in production — those
# are always https://vistrial.io. Do not 308 www to apex until apex DNS is
# on Vercel. Local default is http://localhost:3000.
# ============================================
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# HighLevel “Share → Embed” iframe src for the Lead Leak Audit calendar.
# NEXT_PUBLIC_AUDIT_BOOKING_WIDGET_SRC=
# NEXT_PUBLIC_AUDIT_BOOKING_EMBED_SCRIPT=https://link.msgsndr.com/js/form_embed.js
# Inbound webhook so the qualification survey lands in GHL before the calendar.
# AUDIT_GHL_WEBHOOK_URL=
# Marketplace listing URL. Leave blank until the listing is live.
# NEXT_PUBLIC_GHL_MARKETPLACE_URL=
# Optional sink for page_view / cta_click / scroll_depth / form events.
# MARKETING_EVENTS_WEBHOOK_URL=

# ============================================
# CRON (ghost detector + GHL ingest + transcripts + notifications)
# Vercel Cron sends Authorization: Bearer CRON_SECRET.
# Production always requires this secret. A blank value is only allowed locally.
# ============================================
CRON_SECRET=

# ============================================
# NOTIFICATIONS (Prompt 13)
# Delivery is queued. Missing keys fail visibly on test-send and dead-letter.
# Never log a fake send.
# ============================================
RESEND_API_KEY=
# e.g. Vistrial <notifications@app.vistrial.io>
RESEND_FROM=
# Signing secret from the Resend webhook for /api/webhooks/resend
# RESEND_WEBHOOK_SECRET=
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: origin for VAPID
# VAPID_SUBJECT=mailto:ops@vistrial.io
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
