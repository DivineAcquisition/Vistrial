# A config file for Supabase CLI.
# https://supabase.com/docs/guides/local-development/cli/config

project_id = "vistrial"

[api]
enabled = true
port = 54321
schemas = ["public"]

[db]
port = 54322
# Must match the hosted Vistrial project (Postgres 17). 16 is rejected by the
# GitHub integration ("Invalid db.major_version") and fails the Preview check.
major_version = 17

[db.seed]
enabled = true
sql_paths = ["./seed.sql"]

[auth]
enabled = true
site_url = "http://localhost:3000"
additional_redirect_urls = [
  "http://localhost:3000/auth/callback",
  "http://127.0.0.1:3000/auth/callback",
  "https://app.vistrial.io/auth/callback",
]
jwt_expiry = 3600
enable_refresh_token_rotation = true
enable_signup = false

[auth.email]
# Mirrors "Enable the Email provider" in the dashboard. Without it the local
# stack rejects every password sign-in with "Email logins are disabled".
enabled = true
enable_signup = false
enable_confirmations = true
